{
  "name": "JS protocol emulator",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.1": {
      "moby": true,
      "dockerDashComposeVersion": "none"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "rm -rf tt && cp -a /opt/tt-support-tools tt",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ocamllabs.ocaml-platform",
        "mshr-h.veriloghdl",
        "surfer-project.surfer"
      ]
    }
  }
}
